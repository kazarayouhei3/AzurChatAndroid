<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AzurChat.CharaPage"
    Title="好友信息"
    BackgroundColor="#E4F0FF"
    NavigationPage.HasNavigationBar="True">

    <VerticalStackLayout
        Padding="16,20"
        Spacing="20">

        <!-- 好友头像和昵称卡片 -->
        <Border
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            Padding="20"
            HeightRequest="120">

            <Grid
                ColumnDefinitions="72,*"
                ColumnSpacing="16"
                VerticalOptions="Center">

                <Image
                    x:Name="AvatarImage"
                    Grid.Column="0"
                    WidthRequest="64"
                    HeightRequest="64"
                    Aspect="AspectFill"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />

                <Label
                    x:Name="NameLabel"
                    Grid.Column="1"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#222222"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation" />

            </Grid>
        </Border>

        <!-- 功能列表卡片 -->
        <Border
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20">

            <VerticalStackLayout Spacing="0">

                <!-- 回忆往昔 -->
                <Grid
                    HeightRequest="64"
                    ColumnDefinitions="36,*"
                    ColumnSpacing="14"
                    Padding="20,0">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="MemButton_Tapped" />
                    </Grid.GestureRecognizers>

                    <Image
                        Grid.Column="0"
                        Source="mem.png"
                        WidthRequest="28"
                        HeightRequest="28"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="回忆往昔"
                        FontSize="16"
                        TextColor="#222222"
                        VerticalOptions="Center" />
                </Grid>

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="#EEEEEE"
                    Margin="20,0" />

                <!-- 设为置顶 -->
                <Grid
                    HeightRequest="64"
                    ColumnDefinitions="36,*"
                    ColumnSpacing="14"
                    Padding="20,0">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="TopButton_Tapped" />
                    </Grid.GestureRecognizers>

                    <Image
                        Grid.Column="0"
                        Source="top.png"
                        WidthRequest="28"
                        HeightRequest="28"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="设为置顶"
                        FontSize="16"
                        TextColor="#222222"
                        VerticalOptions="Center" />
                </Grid>

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="#EEEEEE"
                    Margin="20,0" />

                <!-- 删除回忆 -->
                <Grid
                    HeightRequest="64"
                    ColumnDefinitions="36,*"
                    ColumnSpacing="14"
                    Padding="20,0">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="DelButton_Tapped" />
                    </Grid.GestureRecognizers>

                    <Image
                        Grid.Column="0"
                        Source="del.png"
                        WidthRequest="28"
                        HeightRequest="28"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="删除回忆"
                        FontSize="16"
                        TextColor="#222222"
                        VerticalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentPage>