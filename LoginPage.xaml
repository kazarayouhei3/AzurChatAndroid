<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AzurChat.LoginPage"
    Title="AzurChat"
    Shell.NavBarIsVisible="False">
    
    <ContentPage.Content >
        
        <Grid
            BackgroundColor="#ECF3FA"
            RowDefinitions="50,*,50">
            <!-- ================= 顶部导航栏 ================= -->
            <Grid
                Grid.Row="0"
                BackgroundColor="White"
                ColumnDefinitions="50,*,50">

                <!-- 左侧菜单 -->
                <ImageButton
                    x:Name="MenuButton"
                    Grid.Column="0"
                    Source="menu.png"
                    WidthRequest="32"
                    HeightRequest="32"
                    Padding="8"
                    Aspect="AspectFit"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Clicked="OnMenuClicked"/>

                <!-- 标题 -->
                <Label
                    Grid.Column="1"
                    Text="AzurChat"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Grid>
            <VerticalStackLayout
                Grid.Row="1"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                Margin="35,0"
                Spacing="12">

                <!-- 用户名白块 -->
                <Border
                    BackgroundColor="White"
                    Stroke="#22000000"
                    StrokeThickness="1"
                    HeightRequest="58"
                    Padding="16,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Entry
                        x:Name="UserEntry"
                        Placeholder="用户名"
                        BackgroundColor="Transparent"
                        FontSize="16"
                        VerticalOptions="Center"/>
                </Border>

                <!-- 密码白块 -->
                <Border
                    BackgroundColor="White"
                    Stroke="#22000000"
                    StrokeThickness="1"
                    HeightRequest="58"
                    Padding="16,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="密码"
                        IsPassword="True"
                        BackgroundColor="Transparent"
                        FontSize="16"
                        VerticalOptions="Center"/>
                </Border>

                <!-- 登录按钮 -->
                <Button
                    x:Name="LoginButton"
                    Text="登录"
                    HeightRequest="58"
                    Margin="0,12,0,0"
                    HorizontalOptions="Fill"
                    BackgroundColor="#7DB9D8"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    BorderWidth="0"
                    Clicked="OnLoginClicked"
                    />

            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center"
                                   Spacing="5" Margin="0, 5">
                <Button
                    Text="指挥官注册"
                    BackgroundColor="Transparent"
                    TextColor="#2563EB"
                    Padding="4,0"
                    MinimumWidthRequest="0"
                    MinimumHeightRequest="0"
                    Clicked="OnRegisterClicked"/>

                <Button
                    Text="问题反馈"
                    BackgroundColor="Transparent"
                    TextColor="#2563EB"
                    Padding="4,0"
                    MinimumWidthRequest="0"
                    MinimumHeightRequest="0"
                    Clicked="OnFeedbackClicked"/>
                
                
            </HorizontalStackLayout>
            <Grid
                x:Name="FeedbackPopup"
                Grid.RowSpan="3"
                IsVisible="False"
                BackgroundColor="#66000000">

                <Border
                    WidthRequest="300"
                    Padding="25"
                    BackgroundColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="20">

                        <Label
                            Text="问题反馈"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="Black"
                            HorizontalOptions="Center"/>

                        <HorizontalStackLayout
                            Spacing="4"
                            HorizontalOptions="Center">

                            <Label
                                Text="请加入我们："
                                FontSize="16"
                                TextColor="Black"/>

                            <Label
                                Text="1080606836"
                                FontSize="16"
                                TextColor="#2563EB"
                                TextDecorations="Underline">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnQqGroupTapped"/>
                                </Label.GestureRecognizers>

                            </Label>

                        </HorizontalStackLayout>

                        <Button
                            Text="关闭"
                            BackgroundColor="#7DB9D8"
                            TextColor="White"
                            CornerRadius="15"
                            Clicked="OnCloseFeedbackClicked"/>

                    </VerticalStackLayout>

                </Border>

            </Grid>
            <!-- 左上角菜单 -->
            <Grid
                x:Name="MenuPopup"
                Grid.RowSpan="3"
                IsVisible="False"
                BackgroundColor="#66000000">

                <!-- 点击灰色区域关闭 -->
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuBackgroundTapped"/>
                </Grid.GestureRecognizers>

                <!-- 菜单白框 -->
                <Border
                    WidthRequest="105"
                    Margin="8,54,0,0"
                    Padding="4"
                    BackgroundColor="White"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Stroke="#E5E7EB"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Opacity="0.20"
                            Radius="6"
                            Offset="0,2"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="2">

                        <!-- 关于 -->
                        <Button
                            Text="关于"
                            HeightRequest="38"
                            Padding="4,0"
                            BackgroundColor="Transparent"
                            TextColor="#111111"
                            FontSize="17"
                            CornerRadius="6"
                            Clicked="OnAboutClicked"/>

                        <!-- 分割线 -->
                        <BoxView
                            HeightRequest="1"
                            Margin="6,1"
                            BackgroundColor="#E5E7EB"/>

                        <!-- 退出 -->
                        <Button
                            Text="退出"
                            HeightRequest="38"
                            Padding="4,0"
                            BackgroundColor="Transparent"
                            TextColor="#DC2626"
                            FontSize="17"
                            CornerRadius="6"
                            Clicked="OnExitClicked"/>

                    </VerticalStackLayout>

                </Border>

            </Grid>
        </Grid> 
    </ContentPage.Content>
</ContentPage>