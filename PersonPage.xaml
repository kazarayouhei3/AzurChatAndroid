<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AzurChat.Pages.PersonPage"
    BackgroundColor="#ECF3FA"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    Padding="0">

    <Grid RowDefinitions="50,*" RowSpacing="0">

        <!-- 顶部标题栏 -->
        <Grid
            Grid.Row="0"
            BackgroundColor="White"
            Padding="14,0"
            ColumnDefinitions="40,*,40">

            <Label
                Grid.Column="0"
                Text="‹"
                FontSize="32"
                TextColor="#222222"
                VerticalOptions="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="BackButton_Clicked"/>
                </Label.GestureRecognizers>
            </Label>

            <Label
                Grid.Column="1"
                Text="指挥官信息"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#202020"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

        <!-- 页面内容 -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="12,16,12,24"
                Spacing="0">

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="16,20">

                    <VerticalStackLayout Spacing="0">

                        <!-- 头像 -->
                        <VerticalStackLayout
                            Spacing="0"
                            Margin="0,0,0,16">

                            <Grid
                                WidthRequest="110"
                                HeightRequest="110"
                                HorizontalOptions="Center">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnAvatarTapped"/>
                                </Grid.GestureRecognizers>

                                <Image
                                    x:Name="head"
                                    WidthRequest="100"
                                    HeightRequest="100"
                                    Aspect="AspectFill"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Image.Clip>
                                        <EllipseGeometry
                                            Center="50,50"
                                            RadiusX="50"
                                            RadiusY="50"/>
                                    </Image.Clip>
                                </Image>

                                <Border
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    BackgroundColor="#365A9D"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 15"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    InputTransparent="True">

                                    <Label
                                        Text="✎"
                                        FontSize="17"
                                        TextColor="White"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>
                            </Grid>

                            <!-- 点击更换头像 -->
                            <Label
                                Text="点击更换头像"
                                FontSize="13"
                                TextColor="#8B97A8"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Margin="0,8,0,0">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnAvatarTapped"/>
                                </Label.GestureRecognizers>
                            </Label>

                        </VerticalStackLayout>

                        <!-- 头像展开菜单 -->
                        <Grid
                            x:Name="AvatarOptions"
                            IsVisible="False"
                            HeightRequest="0"
                            Opacity="0"
                            Margin="0,0,0,0">

                            <Border
                                BackgroundColor="#F4F7FC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,0">

                                <Grid RowDefinitions="48,1,48">

                                    <!-- 相册 -->
                                    <Grid
                                        Grid.Row="0"
                                        Padding="12,0"
                                        ColumnDefinitions="32,*">

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="SelectPhoto_Tapped"/>
                                        </Grid.GestureRecognizers>

                                        <Image
                                            Source="gallery.png"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Grid.Column="1"
                                            Text="从相册选择"
                                            FontSize="15"
                                            TextColor="#222222"
                                            VerticalOptions="Center"/>
                                    </Grid>

                                    <BoxView
                                        Grid.Row="1"
                                        BackgroundColor="#E5EAF2"/>

                                    <!-- 相机 -->
                                    <Grid
                                        Grid.Row="2"
                                        Padding="12,0"
                                        ColumnDefinitions="32,*">

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="TakePhoto_Tapped"/>
                                        </Grid.GestureRecognizers>

                                        <Image
                                            Source="camera.png"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Grid.Column="1"
                                            Text="拍摄照片"
                                            FontSize="15"
                                            TextColor="#222222"
                                            VerticalOptions="Center"/>
                                    </Grid>

                                </Grid>
                            </Border>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE"
                            Margin="0,16,0,0"/>

                        <!-- 昵称 -->
                        <Grid
                            ColumnDefinitions="75,*,20"
                            Padding="0,10"
                            MinimumHeightRequest="58">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNameClicked"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Text="昵称"
                                FontSize="16"
                                TextColor="#222222"
                                VerticalOptions="Center"/>

                            <Label
                                x:Name="name"
                                Grid.Column="1"
                                FontSize="14"
                                TextColor="#888888"
                                HorizontalTextAlignment="End"
                                VerticalOptions="Center"
                                LineBreakMode="TailTruncation"/>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="24"
                                TextColor="#999999"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE"/>

                        <!-- 个性签名 -->
                        <Grid
                            Padding="0,12"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="5">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnSignatureClicked"/>
                            </Grid.GestureRecognizers>

                            <Grid ColumnDefinitions="*,20">

                                <Label
                                    Text="个性签名"
                                    FontSize="16"
                                    TextColor="#222222"/>

                                <Label
                                    Grid.Column="1"
                                    Text="›"
                                    FontSize="24"
                                    TextColor="#999999"
                                    HorizontalOptions="End"/>
                            </Grid>

                            <Label
                                x:Name="lineEdit"
                                Grid.Row="1"
                                FontSize="13"
                                TextColor="#999999"
                                LineBreakMode="TailTruncation"/>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE"/>

                        <!-- 生日 -->
                        <Grid
                            ColumnDefinitions="*,Auto,20"
                            Padding="0,10"
                            MinimumHeightRequest="58">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBirthdayClicked"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Text="生日"
                                FontSize="16"
                                TextColor="#222222"
                                VerticalOptions="Center"/>

                            <Label
                                x:Name="BirthdayLabel"
                                Grid.Column="1"
                                Text="未设置"
                                FontSize="14"
                                TextColor="#888888"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="24"
                                TextColor="#999999"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE"/>

                        <!-- 地区 -->
                        <Grid
                            ColumnDefinitions="*,Auto,20"
                            Padding="0,10"
                            MinimumHeightRequest="58">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnRegionClicked"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Text="地区"
                                FontSize="16"
                                TextColor="#222222"
                                VerticalOptions="Center"/>

                            <Label
                                x:Name="RegionLabel"
                                Grid.Column="1"
                                Text="未设置"
                                FontSize="14"
                                TextColor="#888888"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="2"
                                Text="›"
                                FontSize="24"
                                TextColor="#999999"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <!-- 分隔线 -->
                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE"/>

                        <!-- 等级 -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="0,10"
                            MinimumHeightRequest="58">

                            <Label
                                Text="等级"
                                FontSize="16"
                                TextColor="#222222"
                                VerticalOptions="Center"/>

                            <Label
                                x:Name="rank"
                                Grid.Column="1"
                                FontSize="14"
                                TextColor="#888888"
                                HorizontalTextAlignment="End"
                                VerticalOptions="Center"/>

                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
