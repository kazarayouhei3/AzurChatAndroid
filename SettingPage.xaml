<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AzurChat.SettingPage"
    BackgroundColor="#ECF3FA"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="50,*" RowSpacing="0">

        <!-- 顶部标题栏 -->
        <Grid
            Grid.Row="0"
            BackgroundColor="White"
            Padding="14,0"
            ColumnDefinitions="40,*,40">

            <Label
                Grid.Column="0"
                Text="‹"
                FontSize="32"
                TextColor="#222222"
                VerticalOptions="Center"
                HorizontalOptions="Start">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="BackButton_Clicked"/>
                </Label.GestureRecognizers>
            </Label>

            <Label
                Grid.Column="1"
                Text="设置"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#202020"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

        <!-- 页面内容 -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="12,16,12,24"
                Spacing="0">

                <!-- 白色圆角卡片 -->
                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="16,8">

                    <VerticalStackLayout Spacing="0">

                        <!-- 指挥官设置 -->
                        <Grid
                            ColumnDefinitions="*,20"
                            Padding="0,12"
                            MinimumHeightRequest="58">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="CommanderSetting_Tapped"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Text="指挥官设置"
                                FontSize="16"
                                TextColor="#222222"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="24"
                                TextColor="#999999"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE"/>

                        <!-- 舰娘设置 -->
                        <Grid
                            ColumnDefinitions="*,20"
                            Padding="0,12"
                            MinimumHeightRequest="58">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="CharaSetting_Tapped"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Text="舰娘设置"
                                FontSize="16"
                                TextColor="#222222"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="24"
                                TextColor="#999999"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE"/>

                        <!-- 通知 -->
                        <Grid
                            ColumnDefinitions="*,20"
                            Padding="0,12"
                            MinimumHeightRequest="58">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="Notification_Tapped"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Text="通知"
                                FontSize="16"
                                TextColor="#222222"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="24"
                                TextColor="#999999"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEEEEE"/>

                        <!-- 我有问题 -->
                        <Grid
                            ColumnDefinitions="*,20"
                            Padding="0,12"
                            MinimumHeightRequest="58">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="Feedback_Tapped"/>
                            </Grid.GestureRecognizers>

                            <Label
                                Text="我有问题"
                                FontSize="16"
                                TextColor="#222222"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="24"
                                TextColor="#999999"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 意见反馈弹窗 -->
        <Grid
            x:Name="FeedbackPopup"
            Grid.RowSpan="2"
            IsVisible="False"
            BackgroundColor="#66000000">

            <Border
                WidthRequest="300"
                Padding="25"
                BackgroundColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="20">

                    <Label
                        Text="问题反馈"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="Black"
                        HorizontalOptions="Center"/>

                    <HorizontalStackLayout
                        Spacing="4"
                        HorizontalOptions="Center">

                        <Label
                            Text="请加入我们："
                            FontSize="16"
                            TextColor="Black"/>

                        <Label
                            Text="1080606836"
                            FontSize="16"
                            TextColor="#2563EB"
                            TextDecorations="Underline">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnQqGroupTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                    </HorizontalStackLayout>

                    <Button
                        Text="关闭"
                        BackgroundColor="#7DB9D8"
                        TextColor="White"
                        CornerRadius="15"
                        Clicked="OnCloseFeedbackClicked"/>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
